{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidoc.dev/schema/0.1/chunks.json",
  "title": "aidoc 0.1 chunks",
  "description": "Decoded content of the application/aidoc-chunks+json data block. Array index i MUST equal the N in id \"c<N>\". Licence: CC BY 4.0.",
  "type": "array",
  "minItems": 1,
  "maxItems": 20000,
  "items": {
    "type": "object",
    "required": ["id", "sectionId", "headingPath", "text", "blocks", "tokens"],
    "properties": {
      "id": { "type": "string", "pattern": "^c(0|[1-9][0-9]*)$" },
      "sectionId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$" },
      "headingPath": {
        "type": "array",
        "maxItems": 6,
        "items": { "type": "string", "maxLength": 500 }
      },
      "text": { "type": "string", "minLength": 1, "maxLength": 10000 },
      "blocks": {
        "type": "array",
        "minItems": 1,
        "maxItems": 1000,
        "items": { "type": "string", "pattern": "^b(0|[1-9][0-9]*)$" }
      },
      "tokens": { "type": "integer", "minimum": 0, "maximum": 4096 }
    },
    "patternProperties": { "^x-": true },
    "additionalProperties": false
  }
}
