{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidoc.dev/schema/0.1/graph.json",
  "title": "aidoc 0.1 concept graph",
  "description": "Concept graph. Used both for the authoring source file (graph.json) and for the packaged application/aidoc-graph+json data block. Edge endpoints, node sectionIds and id uniqueness are checked by validators. Licence: CC BY 4.0.",
  "type": "object",
  "required": ["nodes", "edges"],
  "properties": {
    "nodes": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "type": "string", "minLength": 1, "maxLength": 200 },
          "aliases": {
            "type": "array",
            "maxItems": 20,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 200 }
          },
          "sectionId": { "$ref": "#/$defs/id" },
          "description": { "type": "string", "minLength": 1, "maxLength": 2000 }
        },
        "patternProperties": { "^x-": true },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "required": ["from", "to", "relation"],
        "properties": {
          "from": { "$ref": "#/$defs/id" },
          "to": { "$ref": "#/$defs/id" },
          "relation": { "type": "string", "minLength": 1, "maxLength": 60 }
        },
        "patternProperties": { "^x-": true },
        "additionalProperties": false
      }
    }
  },
  "patternProperties": { "^x-": true },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$" }
  }
}
